# Copy this file to .env. Never commit the completed .env file.
POSTGRES_VERSION=16
POSTGRES_DB=monakabu_realtime
POSTGRES_USER=monakabu
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_url_safe_random_hex

# Must exactly match MONAKABU_REALTIME_SECRET on the Paper server.
MONAKABU_SHARED_SECRET=replace_with_existing_shared_secret
MONAKABU_SERVER_ID=monaka-main

ALLOWED_ORIGINS=https://monakabu-realtime-dashboard.vercel.app
API_PORT=10000
DATABASE_POOL_SIZE=10
SIGNATURE_MAX_AGE_SECONDS=300
WEB_SESSION_DAYS=14
WEB_MAX_SHARES_PER_ORDER=1000

